# Frontend env vars (Vercel). Copy to .env.local for local dev.
# DO NOT COMMIT .env.local — it is gitignored for security.

# --- Clerk (https://dashboard.clerk.com) ---
# Required for auth. Get these from Clerk Dashboard → Settings → API Keys.
# NEXT_PUBLIC_ prefix: safe to expose in browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY: server-side only; read by Next.js API routes, NOT the browser.
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/select-role

# --- Supabase (https://supabase.com) ---
# Required for PostgreSQL tables (products, orders, wishlists, users) and Realtime sync.
NEXT_PUBLIC_SUPABASE_URL=https://mkeowabbnpyenqeiybzw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# --- Google AI / Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GOOGLE_GENAI_API_KEY=

# --- AI assistant ---
# Set to "true" to force the heritage chat assistant into simulation mode.
MOCK_AI=false
# Per-user daily chat message budget (default: 30).
CHAT_DAILY_LIMIT=30

# --- Firebase (https://console.firebase.google.com) ---
# Required for auth bridge, Firestore, and Storage. Get from Firebase Console.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- FastAPI backend ---
# Must point to your live backend URL when deployed (e.g. Render URL).
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:9002

# --- Firebase Admin (server-side: orders, webhooks, auth bridge) ---
# Raw JSON or base64 of a Firebase service account.
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Email notifications (Resend, https://resend.com) ---
RESEND_API_KEY=
EMAIL_FROM=Viraasat <noreply@viraasat.in>
EMAIL_REPLY_TO=care@viraasat.in

# --- Razorpay (https://dashboard.razorpay.com/app/keys) ---
# Required for checkout. Get test/live keys from Razorpay Dashboard.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Optional: Sentry (https://sentry.io) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
