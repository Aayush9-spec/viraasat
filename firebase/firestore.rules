rules_version = '2';

// Cloud Firestore security rules for Viraasat
// Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers ----
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function hasRole(role) {
      return isSignedIn() && request.auth.token.role == role;
    }
    function isArtisan() {
      return hasRole('artisan');
    }
    function isAdmin() {
      return hasRole('admin');
    }
    // A client may only assign a non-admin role to itself. The 'admin' role
    // must be provisioned server-side (Clerk custom claim / backend pipeline).
    function isSelfAssignedRole(role) {
      return role == 'buyer' || role == 'artisan';
    }

    // ---- Users ----
    // Users can create their own doc on signup, read their own, update their own.
    // Admins can read/write all.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasAll(['uid', 'email', 'role'])
        && isSelfAssignedRole(request.resource.data.role);
      // Owners may update their own doc, but cannot escalate themselves to admin.
      allow update: if isAdmin() || (
        isOwner(userId)
        && (request.resource.data.role == resource.data.role
            || isSelfAssignedRole(request.resource.data.role))
      );
      allow delete: if isAdmin();

      // Wishlist subcollection
      match /wishlist/{itemId} {
        allow read, write: if isOwner(userId);
      }

      // Cart subcollection
      match /cart/{itemId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ---- Products ----
    // Public read. Only artisans can create (must own). Owner or admin can update/delete.
    match /products/{productId} {
      allow read: if true;
      allow create: if isArtisan()
        && request.resource.data.artisanId == request.auth.uid;
      allow update, delete: if isSignedIn()
        && (resource.data.artisanId == request.auth.uid || isAdmin());

      // Reviews subcollection
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isSignedIn()
          && request.resource.data.reviewerId == request.auth.uid
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5;
        allow update, delete: if isSignedIn()
          && (resource.data.reviewerId == request.auth.uid || isAdmin());
      }
    }

    // ---- Orders ----
    // Only buyer (owner) or admin can read. Only buyer can create.
    match /orders/{orderId} {
      allow read: if isSignedIn()
        && (resource.data.buyerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && request.resource.data.buyerId == request.auth.uid;
      // Orders are immutable from the client; status changes happen via the backend.
      allow update, delete: if isAdmin();
    }

    // ---- Artisan applications ----
    // Anyone signed in can submit; only admin can read/update.
    match /artisanApplications/{appId} {
      allow create: if isSignedIn()
        && request.resource.data.applicantId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // ---- Newsletter subscriptions ----
    // Signed-in users may subscribe with a validated email; only admin can list/delete.
    match /newsletter/{subId} {
      allow create: if isSignedIn()
        && request.resource.data.email is string
        && request.resource.data.email.size() > 5
        && request.resource.data.userId == request.auth.uid;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // ---- Artisan profiles ----
    // Public read. Owner or admin can create/update.
    match /artisans/{artisanId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.artisanId == request.auth.uid;
      allow update: if isSignedIn()
        && (resource.data.artisanId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // ---- Contact submissions ----
    // Signed-in users may submit; only admin can read.
    match /contactSubmissions/{submissionId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ---- Knowledge graph / catalogue read-only data ----
    match /crafts/{craftId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- Default deny ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
