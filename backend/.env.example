# Backend env vars (Render). DO NOT COMMIT a populated copy.
#
# Populate these in the Render dashboard for the FastAPI service.
# Locally, copy to backend/.env (gitignored).

# --- CORS: comma-separated allowed origins ---
# Must include production Vercel domain, e.g. https://your-app.vercel.app
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:9002

# --- Clerk (for verifying JWTs sent from the Next.js frontend) ---
# Frontend instance URL, e.g. https://YOUR_APP.clerk.accounts.dev (no trailing slash).
CLERK_ISSUER=https://your-app.clerk.accounts.dev
# Optional: explicit JWKS URL. Defaults to {CLERK_ISSUER}/.well-known/jwks.json.
CLERK_JWKS_URL=
# When "true" (default), all protected /api endpoints reject unauthenticated
# requests. Set to "false" ONLY in non-production environments.
# For local dev: set REQUIRE_AUTH=false so ML/blockchain/fraud endpoints work
# without a Clerk JWT.  NEVER set false in ENVIRONMENT=production.
REQUIRE_AUTH=false
ENVIRONMENT=development
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# DEPRECATED: not read by any code (JWT verification uses CLERK_ISSUER/CLERK_JWKS_URL).
CLERK_JWT_KEY=
# Signing secret for the Clerk → backend user-sync webhook.
# Get it from: Clerk Dashboard → Webhooks → your endpoint → Signing Secret
# REQUIRED: must be set for production; webhook syncs user data to Firestore
CLERK_WEBHOOK_SIGNING_SECRET=

# --- Razorpay (https://dashboard.razorpay.com/app/keys) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Firebase Admin (service account JSON, base64-encoded or path) ---
# Generate at: Firebase Console > Project Settings > Service Accounts
# Base64-encode the service account JSON and paste the result here:
#   cat service-account.json | base64 -w 0
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Persistence ---
# Options:
#   sqlite:///./viraasat.db   (default; file-based, persists across restarts)
#   memory://                 (in-process only; tests)
#   firestore://PROJECT_ID    (uses firebase-admin via FIREBASE_SERVICE_ACCOUNT_JSON)
DATABASE_URL=sqlite:///./viraasat.db
# Custom SQLite file path used by the storage layer (default: viraasat.db).
SQLITE_PATH=viraasat.db

# --- Image moderation (backend/app/api/moderation.py) ---
# Enable Google Cloud Vision SafeSearch. Defaults to true; when disabled the
# endpoint returns a soft "safe_search_disabled" pass.
# RECOMMENDED: set true for production GOOGLE_CLOUD_VISION_ENABLED=true
GOOGLE_CLOUD_VISION_ENABLED=true
# Optional CSAM perceptual-hash stopgap. Requires Pillow. Defaults to false.
# MUST be set to true and CSAM_HASH_FILE provisioned for production deployments
# serving users in jurisdictions with CSA(M) reporting laws.
CSAM_HASH_ENABLED=false
CSAM_HASH_FILE=/run/secrets/csam-hashes

# --- Optional: Sentry ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
ENVIRONMENT=production
